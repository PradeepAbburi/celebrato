{
  "entities": {
    "Room": {
      "title": "Party Room",
      "description": "Party room details, capacity, media, pricing and reward points",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "theme": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 1000 },
        "capacity": { "type": "number" },
        "pricePerHour": { "type": "number" },
        "rewardPoints": { "type": "number" },
        "pictures": { "type": "array" },
        "videoUrl": { "type": "string", "maxLength": 500 },
        "amenities": { "type": "array" },
        "soundLightingSpecs": { "type": "string", "maxLength": 300 },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "capacity", "pricePerHour", "rewardPoints", "pictures"]
    },
    "Booking": {
      "title": "Party Room Booking",
      "description": "Customer booking with party room, date, add-ons, pricing, points and status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "userName": { "type": "string", "maxLength": 100 },
        "userPhone": { "type": "string", "maxLength": 30 },
        "roomId": { "type": "string", "maxLength": 128 },
        "roomName": { "type": "string", "maxLength": 100 },
        "roomImage": { "type": "string", "maxLength": 500 },
        "date": { "type": "string", "maxLength": 20 },
        "timeSlot": { "type": "string", "maxLength": 30 },
        "durationHours": { "type": "number" },
        "guestsCount": { "type": "number" },
        "basePrice": { "type": "number" },
        "addOnsTotal": { "type": "number" },
        "finalPrice": { "type": "number" },
        "pointsEarned": { "type": "number" },
        "pointsUsed": { "type": "number" },
        "addOns": { "type": "array" },
        "status": { "type": "string", "enum": ["confirmed", "checked-in", "completed", "cancelled"] },
        "notes": { "type": "string", "maxLength": 500 },
        "shareCode": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "roomId", "date", "timeSlot", "status", "finalPrice"]
    },
    "VaultMedia": {
      "title": "Party Vault Media",
      "description": "Collaborative media uploaded by booker and friends for a party event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookingId": { "type": "string", "maxLength": 128 },
        "folderId": { "type": "string", "maxLength": 128 },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "url": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "uploadedByUid": { "type": "string", "maxLength": 128 },
        "uploadedByName": { "type": "string", "maxLength": 100 },
        "caption": { "type": "string", "maxLength": 500 },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["mediaType", "url", "uploadedByUid"]
    },
    "User": {
      "title": "User Profile",
      "description": "Registered user profile and administrative role flags",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "isAdmin": { "type": "boolean" },
        "phone": { "type": "string", "maxLength": 30 }
      },
      "required": ["uid", "email"]
    },
    "AddOnItem": {
      "title": "Party Add-On",
      "description": "Party equipment, lighting, DJ packages and party add-ons",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "price": { "type": "number" },
        "icon": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 300 }
      },
      "required": ["name", "category", "price"]
    },
    "EventFolder": {
      "title": "Event Media Folder",
      "description": "Collaborative party media folder with invite code and event details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 30 },
        "description": { "type": "string", "maxLength": 500 },
        "coverImage": { "type": "string", "maxLength": 500 },
        "shareCode": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "date"]
    },
    "ContactMessage": {
      "title": "Contact Inquiry",
      "description": "Inquiry form message submitted by guests or event planners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "eventType": { "type": "string", "maxLength": 50 },
        "eventDate": { "type": "string", "maxLength": 30 },
        "guestsEstimated": { "type": "number" },
        "message": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["new", "contacted", "resolved"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message"]
    },
    "VenueSettings": {
      "title": "Venue Configuration Settings",
      "description": "Admin configurable WhatsApp number, venue contact details, and invoice parameters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "whatsappNumber": { "type": "string", "maxLength": 30 },
        "businessName": { "type": "string", "maxLength": 100 },
        "supportEmail": { "type": "string", "maxLength": 150 },
        "venueAddress": { "type": "string", "maxLength": 300 },
        "gstin": { "type": "string", "maxLength": 50 },
        "invoiceNotes": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string" }
      },
      "required": ["whatsappNumber"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles and role configurations"
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "Room" },
      "description": "Party rooms catalog with pricing, images and video preview"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "Booking" },
      "description": "User event bookings with dates, guest count, add-ons and pricing"
    },
    "/vault_media/{mediaId}": {
      "schema": { "$ref": "VaultMedia" },
      "description": "Event media vault where guests and hosts upload party pictures and videos"
    },
    "/addons/{addonId}": {
      "schema": { "$ref": "AddOnItem" },
      "description": "Party equipment packages, neon lighting rigs, and DJ booth add-ons"
    },
    "/event_folders/{folderId}": {
      "schema": { "$ref": "EventFolder" },
      "description": "Party event albums and shared guest vaults"
    },
    "/contacts/{contactId}": {
      "schema": { "$ref": "ContactMessage" },
      "description": "Event inquiries and guest contact messages"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "VenueSettings" },
      "description": "Global venue settings such as admin WhatsApp phone number and invoice parameters"
    }
  }
}
