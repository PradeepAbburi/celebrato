rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isKnownAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'dineshkrishnapradeep@gmail.com' ||
        request.auth.token.email == 'admin@partyhouse.com'
      );
    }

    function isAdmin() {
      return isKnownAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Admin list
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Party Rooms catalog - public read and admin manage
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if true;
    }

    // Party Add-on packages and equipment
    match /addons/{addonId} {
      allow read: if true;
      allow write: if true;
    }

    // Party Event Folders in MemVault
    match /event_folders/{folderId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Bookings - Real-time synchronization for guests and admin operations
    match /bookings/{bookingId} {
      allow read, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || true;
    }

    // Collaborative Party Media Vault
    match /vault_media/{mediaId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Contact Form Inquiries
    match /contacts/{contactId} {
      allow read, list, create, update, delete: if true;
    }

    // Venue & Admin Settings (WhatsApp number, venue address, invoice details)
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
